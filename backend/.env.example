# Copy to backend/.env and fill in. backend/.env is not committed.
# On Render, set these under the service's Environment tab instead.

# Secret for the Experimental AI page (enter the same value on that page).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERR_ADMIN_TOKEN=

# Extra allowed frontend origins, comma-separated. localhost:5173 is always allowed.
# Example for production: https://super-rr-hackathon.vercel.app
SUPERR_CORS_ORIGINS=

# Which results the submission API serves: phase9 (default, includes 2026) or phase8.
SUPERR_SUBMISSION_SOURCE=phase9

# Pipeline settings (used by the data scripts, not by the running API)
SUPERR_DATA_ROOT=D:/Data
SUPERR_CRICSHEET_ROOT=D:/Data
SUPERR_SQUAD_CSV=D:/Data/ipl squad.csv
# SUPERR_PROBLEM_STATEMENT_PDF=
# SUPERR_DUCKDB_PATH=
SUPERR_LOG_LEVEL=INFO
SUPERR_IPL_WEIGHT=0.70
SUPERR_T20I_WEIGHT=0.30
