# Copy to frontend/.env (local) or set in Vercel > Project Settings > Environment Variables.
# URL of the backend API, no trailing slash. Local: http://localhost:8000
# Production: your Render URL, e.g. https://superr-selector-api.onrender.com
# Never put secrets here: every VITE_ variable is bundled into the public website.
VITE_API_ORIGIN=http://localhost:8000
